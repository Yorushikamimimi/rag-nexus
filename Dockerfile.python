# RAG-Nexus Python 抓取微服务
FROM python:3.10-slim

WORKDIR /app

# 复制依赖文件并安装
COPY requirements-scraper.txt .
RUN pip install --no-cache-dir -r requirements-scraper.txt

# 复制服务代码（源文件位于 scripts/scraper_service.py，复制到容器 /app/scraper_service.py）
COPY scripts/scraper_service.py .
# cookies.txt 可选（B 站登录态），通过 volume 挂载到 /app/cookies.txt
# 参考格式：docs/archive/cookies.example.txt

EXPOSE 8000

CMD ["uvicorn", "scraper_service:app", "--host", "0.0.0.0", "--port", "8000"]
